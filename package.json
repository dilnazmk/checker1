{
  "name": "assignment-checker",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.16.0" },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch --env-file-if-exists=.env server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "nodemailer": "^10.0.1",
    "pg": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.5.1",
    "concurrently": "^9.1.2",
    "vite": "^6.3.5",
    "supertest": "^7.1.1",
    "@playwright/test": "^1.52.0"
  }
}
